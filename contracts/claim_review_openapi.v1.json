{
  "openapi": "3.1.0",
  "info": {
    "title": "Insurance Claim Review API",
    "description": "Human-in-the-loop research API. Outputs are decision support, not automatic fraud decisions.",
    "version": "research-v1"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/version": {
      "get": {
        "summary": "Version",
        "operationId": "version_version_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Version Version Get"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claim_id}/analyze": {
      "post": {
        "summary": "Analyze",
        "operationId": "analyze_claims__claim_id__analyze_post",
        "parameters": [
          {
            "name": "claim_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Claim Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnalyzeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimAnalysis"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claim_id}/analysis": {
      "get": {
        "summary": "Analysis",
        "operationId": "analysis_claims__claim_id__analysis_get",
        "parameters": [
          {
            "name": "claim_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Claim Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ClaimAnalysis"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/claims/{claim_id}/review": {
      "post": {
        "summary": "Review",
        "operationId": "review_claims__claim_id__review_post",
        "parameters": [
          {
            "name": "claim_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Claim Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReviewRecord"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AnalyzeRequest": {
        "properties": {
          "claim_amount": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Claim Amount"
          },
          "incident_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Incident Date"
          },
          "plate_number": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Plate Number"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          }
        },
        "type": "object",
        "title": "AnalyzeRequest"
      },
      "ClaimAnalysis": {
        "properties": {
          "schema_version": {
            "type": "string",
            "title": "Schema Version",
            "default": "1.0"
          },
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fixture",
              "live"
            ],
            "title": "Mode"
          },
          "human_review_required": {
            "type": "boolean",
            "title": "Human Review Required",
            "default": true
          },
          "priority": {
            "type": "string",
            "enum": [
              "normal",
              "review",
              "high"
            ],
            "title": "Priority"
          },
          "research_risk_score": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Research Risk Score"
          },
          "risk_score_is_probability": {
            "type": "boolean",
            "title": "Risk Score Is Probability",
            "default": false
          },
          "evidence_completeness": {
            "type": "number",
            "maximum": 1.0,
            "minimum": 0.0,
            "title": "Evidence Completeness"
          },
          "missing_evidence": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Missing Evidence"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "signals": {
            "items": {
              "$ref": "#/components/schemas/Signal"
            },
            "type": "array",
            "title": "Signals"
          },
          "extracted_fields": {
            "additionalProperties": true,
            "type": "object",
            "title": "Extracted Fields"
          },
          "graph_features": {
            "additionalProperties": true,
            "type": "object",
            "title": "Graph Features"
          },
          "model_versions": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Model Versions"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          }
        },
        "type": "object",
        "required": [
          "claim_id",
          "trace_id",
          "created_at",
          "mode",
          "priority",
          "evidence_completeness"
        ],
        "title": "ClaimAnalysis"
      },
      "Evidence": {
        "properties": {
          "evidence_id": {
            "type": "string",
            "title": "Evidence Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "claim",
              "image",
              "document",
              "relationship"
            ],
            "title": "Kind"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "source_uri": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Source Uri"
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Observed At"
          }
        },
        "type": "object",
        "required": [
          "evidence_id",
          "kind",
          "label"
        ],
        "title": "Evidence"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fixture",
              "live"
            ],
            "title": "Mode"
          },
          "product_version": {
            "type": "string",
            "title": "Product Version"
          }
        },
        "type": "object",
        "required": [
          "mode",
          "product_version"
        ],
        "title": "HealthResponse"
      },
      "ReviewRecord": {
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 2,
            "title": "Reviewer Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "continue_processing",
              "request_evidence",
              "special_review"
            ],
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Reason"
          },
          "claim_id": {
            "type": "string",
            "title": "Claim Id"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "reviewer_id",
          "decision",
          "reason",
          "claim_id",
          "trace_id"
        ],
        "title": "ReviewRecord"
      },
      "ReviewRequest": {
        "properties": {
          "reviewer_id": {
            "type": "string",
            "minLength": 2,
            "title": "Reviewer Id"
          },
          "decision": {
            "type": "string",
            "enum": [
              "continue_processing",
              "request_evidence",
              "special_review"
            ],
            "title": "Decision"
          },
          "reason": {
            "type": "string",
            "maxLength": 2000,
            "minLength": 10,
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "reviewer_id",
          "decision",
          "reason"
        ],
        "title": "ReviewRequest"
      },
      "Signal": {
        "properties": {
          "signal_id": {
            "type": "string",
            "title": "Signal Id"
          },
          "category": {
            "type": "string",
            "enum": [
              "risk",
              "damage",
              "document",
              "consistency",
              "relationship"
            ],
            "title": "Category"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "review",
              "high"
            ],
            "title": "Severity"
          },
          "evidence_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Evidence Ids"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 1.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "model_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Name"
          },
          "model_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Model Version"
          }
        },
        "type": "object",
        "required": [
          "signal_id",
          "category",
          "title",
          "explanation",
          "severity"
        ],
        "title": "Signal"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}